  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malikrajat/tracepulse.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.iife.global.js",
  "jsdelivr": "./dist/index.iife.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./report": {
      "import": {
        "types": "./dist/report.d.ts",
        "default": "./dist/report.js"
      },
      "require": {
        "types": "./dist/report.d.cts",
        "default": "./dist/report.cjs"
      },
      "default": "./dist/report.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp pack",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check:package": "pnpm run check:dist && pnpm run check:exports && pnpm run check:types && pnpm run check:size",
    "check:dist": "node scripts/check-dist.mjs",
    "check:exports": "publint --strict",
    "check:types": "attw --pack . --profile node16",
    "check:size": "size-limit",
    "verify": "vp check && vp test run --coverage && vp pack && pnpm run check:package && pnpm run test:browser",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "vp pack && changeset publish",
    "prepublishOnly": "vp pack",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "vitepress": "2.0.0-alpha.20"
  },
  "size-limit": [
    {
      "name": "ESM bundle (minified, brotli)",
      "path": "dist/index.js",
      "limit": "17 kB"
    }
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
